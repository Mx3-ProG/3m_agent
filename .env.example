# Backend
THREEM_ENV=development
THREEM_DATABASE_URL=sqlite+aiosqlite:///./data/3m.sqlite3
THREEM_API_TOKEN=replace-with-a-long-random-token
THREEM_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000
THREEM_DEFAULT_LLM_PROVIDER=demo
THREEM_DEFAULT_LLM_MODEL=3m-demo
THREEM_CONTEXT_RECENT_MESSAGES=20
THREEM_CONTEXT_BUDGET_CHARACTERS=16000
THREEM_CONVERSATION_SUMMARY_THRESHOLD=24
THREEM_USER_TIMEZONE=Europe/Paris

# Calendar provider: demo by default. Use apple only after building the local bridge
# and explicitly granting Calendar access with its request-access command.
THREEM_CALENDAR_PROVIDER=demo
THREEM_APPLE_CALENDAR_BRIDGE_PATH=native/apple-calendar-bridge/.build/apple-calendar-bridge
THREEM_APPLE_CALENDAR_IDENTIFIER=

# LLM providers (server-side only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Voice (server-side only)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
THREEM_MAX_TTS_CHARACTERS=2500

# Next.js server-side proxy. Must match THREEM_API_TOKEN.
THREEM_BACKEND_URL=http://127.0.0.1:8000
THREEM_BACKEND_TOKEN=replace-with-a-long-random-token
